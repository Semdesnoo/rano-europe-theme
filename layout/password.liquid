<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  <style>:root{--ink:{{ settings.color_ink }};--bg:{{ settings.color_bg }};--card:{{ settings.color_card }};--sale:{{ settings.color_sale }};--logo-w:{{ settings.logo_width }}px}</style>
  {{ 'rano.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="main">{{ content_for_layout }}</main>
</body>
</html>
