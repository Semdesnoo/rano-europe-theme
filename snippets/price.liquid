{%- comment -%} Params: price, compare (cents) {%- endcomment -%}
{%- if compare > price -%}
  <span class="price price--sale">
    <span class="price__now">{{ price | money }}</span>
    <s class="price__was">{{ compare | money }}</s>
  </span>
{%- else -%}
  <span class="price"><span class="price__now">{{ price | money }}</span></span>
{%- endif -%}
