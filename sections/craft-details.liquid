<section class="section details">
  <div class="container">
    {%- if section.settings.heading != blank -%}<h2 class="h2 details__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="details__grid">
      {%- for block in section.blocks -%}
        {%- assign s = block.settings -%}
        <figure class="details__item reveal" {{ block.shopify_attributes }}>
          <div class="details__media">{% render 'media', image: s.image, fallback: s.fallback, sizes: '(min-width: 990px) 40vw, 85vw', class: 'cover', alt: s.title %}</div>
          <figcaption>
            <h3 class="details__title">{{ s.title }}</h3>
            <p>{{ s.text }}</p>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Craft details",
  "class": "section-details",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Rano" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Detail",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Bundled image file" },
        { "type": "text", "id": "title", "label": "Title", "default": "Genuine leather" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Full-grain leather that softens and ages with character." }
      ]
    }
  ],
  "presets": [{ "name": "Craft details", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
