<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <img src="{{ 'logo-black.png' | asset_url }}" class="logo logo--footer" alt="{{ shop.name }}" loading="lazy" width="948" height="355">
        <p>{{ section.settings.about }}</p>
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}<a class="icon-btn" href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a class="icon-btn" href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
        </div>
      </div>

      <div class="footer__news">
        <h2 class="footer__h">{{ section.settings.news_heading }}</h2>
        <p>{{ section.settings.news_text }}</p>
        {%- form 'customer', class: 'news-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="form-ok" role="status">Thank you. You are on the list.</p>
          {%- else -%}
            <label for="footer-email" class="news-form__label">Email</label>
            <div class="news-form__row">
              <input id="footer-email" type="email" name="contact[email]" required autocomplete="email" placeholder="you@example.com">
              <button type="submit" class="icon-btn" aria-label="Subscribe">{% render 'icon', name: 'arrow-right' %}</button>
            </div>
            {%- if form.errors -%}<p class="form-err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <nav class="footer__cols" aria-label="Footer">
      {%- for i in (1..3) -%}
        {%- assign key = 'menu_' | append: i -%}
        {%- assign m = section.settings[key] -%}
        {%- if m.links.size > 0 -%}
          <details class="footer__col" open data-footer-col>
            <summary>{{ m.title }}{% render 'icon', name: 'plus' %}</summary>
            <ul>
              {%- for link in m.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
            </ul>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="footer__bottom">
      <div class="footer__locale">{% render 'localization', up: true %}</div>
      <ul class="footer__pay" aria-label="Payment methods">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'pay-icon' }}</li>{%- endfor -%}
      </ul>
      <p class="footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Designed in Italy.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "textarea", "id": "about", "label": "Brand text", "default": "Born in Casarano, southern Italy. Genuine leather travel pieces made to move with you, wherever you go." },
    { "type": "link_list", "id": "menu_1", "label": "Column 1 (Company)", "default": "footer-company" },
    { "type": "link_list", "id": "menu_2", "label": "Column 2 (Customer service)", "default": "footer" },
    { "type": "link_list", "id": "menu_3", "label": "Column 3 (Shop)", "default": "footer-shop" },
    { "type": "text", "id": "news_heading", "label": "Newsletter heading", "default": "Enter the world of Rano" },
    { "type": "textarea", "id": "news_text", "label": "Newsletter text", "default": "Early access to limited drops. No restocks, so be first." }
  ]
}
{% endschema %}
