{%- comment -%} Full-screen film with a line-by-line title reveal and a scroll cue. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="film-hero" data-film-hero>
  <div class="film-hero__media">
    {% render 'video', video: s.video, video_asset: s.video_asset, poster: s.poster, class: 'cover' %}
  </div>
  <div class="film-hero__content">
    {%- if s.eyebrow != blank -%}<p class="film-hero__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    <h1 class="film-hero__title">
      {%- assign lines = s.heading | split: '|' -%}
      {%- for l in lines -%}<span class="film-hero__line"><span style="--i:{{ forloop.index0 }}">{{ l | strip }}</span></span>{%- endfor -%}
    </h1>
    {%- if s.text != blank -%}<p class="film-hero__text">{{ s.text }}</p>{%- endif -%}
  </div>
  <a href="#{{ s.scroll_to | default: 'story' }}" class="film-hero__scroll" aria-label="Scroll down"><span></span></a>
  {%- if s.badge != blank -%}<p class="film-hero__badge">{{ s.badge }}</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "Film hero",
  "class": "section-film-hero",
  "settings": [
    { "type": "video", "id": "video", "label": "Video (upload)" },
    { "type": "text", "id": "video_asset", "label": "Bundled video file", "default": "atelier.mp4" },
    { "type": "text", "id": "poster", "label": "Bundled poster image", "default": "atelier.jpg" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Use | for a new line.", "default": "Cut by hand.|Made to travel." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "badge", "label": "Corner badge", "default": "Fatto in Italia" },
    { "type": "text", "id": "scroll_to", "label": "Scroll target id", "default": "story" }
  ],
  "presets": [{ "name": "Film hero" }]
}
{% endschema %}
