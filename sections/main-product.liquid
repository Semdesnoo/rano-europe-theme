{%- liquid
  assign current = product.selected_or_first_available_variant
  assign colour = product.title | remove: 'Full Travel Set' | remove: 'Pouch & Card Holder Set' | remove: 'Travel Pouch' | remove: 'Traveller' | remove: 'Card Holder' | remove: 'Cardholder' | strip
-%}
<section class="pdp" data-product>
  <div class="pdp__gallery" data-gallery>
    <div class="pdp__track">
      {%- for media in product.media -%}
        <div class="pdp__slide{% if forloop.first %} pdp__slide--first{% endif %}{% if media.media_type == 'model' %} pdp__slide--model{% endif %}">
          {%- liquid
            assign loading = 'lazy'
            if forloop.first
              assign loading = 'eager'
            endif
            assign alt_text = media.alt | default: product.title
          -%}
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- if forloop.first and product.images.size > 1 and section.settings.spin -%}
                <div class="spin" data-spin data-images="{% for img in product.images %}{{ img | image_url: width: 1400 }}{% unless forloop.last %}|{% endunless %}{% endfor %}">
                  {{ media | image_url: width: 1800 | image_tag: widths: '500, 800, 1100, 1400, 1800', sizes: '(min-width: 990px) 30vw, 100vw', loading: loading, class: 'cover spin__img', alt: alt_text, draggable: 'false' }}
                  <span class="pdp__model-hint">{% render 'icon', name: 'arrows' %} Drag to rotate</span>
                </div>
              {%- else -%}
                {{ media | image_url: width: 1800 | image_tag: widths: '500, 800, 1100, 1400, 1800', sizes: '(min-width: 990px) 30vw, 100vw', loading: loading, class: 'cover', alt: alt_text }}
              {%- endif -%}
            {%- when 'video' -%}
              {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1100x', class: 'cover' }}
            {%- when 'model' -%}
              {{ media | model_viewer_tag: image_size: '1100x', auto-rotate: true, rotation-per-second: '18deg', interaction-prompt: 'none', shadow-intensity: '1', exposure: '1.05', class: 'pdp__model', alt: alt_text }}
              <button type="button" class="pdp__model-hint pdp__model-btn" data-model-toggle aria-pressed="false">{% render 'icon', name: 'arrows' %} <span data-on>Rotate 3D</span><span data-off hidden>Done</span></button>
            {%- else -%}
              {{ media | media_tag: image_size: '1100x' }}
          {%- endcase -%}
        </div>
      {%- else -%}
        <div class="pdp__slide">{{ 'product-1' | placeholder_svg_tag: 'cover' }}</div>
      {%- endfor -%}
    </div>
    {%- if product.media.size > 1 -%}
      <div class="pdp__dots hide-desktop" aria-hidden="true">
        {%- for media in product.media -%}<span{% if forloop.first %} class="is-active"{% endif %}></span>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="pdp__info">
    <div class="pdp__sticky">
      {%- if product.collections.size > 0 -%}
        {%- assign crumb = product.collections | where: 'handle', 'bags' | first | default: product.collections.first -%}
        <a href="{{ crumb.url }}" class="pdp__crumb">{{ crumb.title }}</a>
      {%- endif -%}
      <h1 class="pdp__title">{{ product.title }}</h1>
      <div class="pdp__price" data-price>{% render 'price', price: current.price, compare: current.compare_at_price %}</div>
      <p class="muted small">Tax included. <a href="{{ section.settings.shipping_link }}" class="link">Free shipping</a>.</p>

      {%- capture sw -%}{% render 'swatches', product: product, large: true %}{%- endcapture -%}
      {%- if sw != blank -%}
        <div class="pdp__opt">
          <p class="pdp__label">{{ 'products.colour' | t }}{% if colour != blank %}: <strong>{{ colour }}</strong>{% endif %}</p>
          {{ sw }}
        </div>
      {%- endif -%}

      {%- form 'product', product, class: 'pdp__form', data-add-form: '', novalidate: 'novalidate' -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="field pdp__opt">
              <label for="opt-{{ forloop.index0 }}" class="pdp__label">{{ option.name }}</label>
              <select id="opt-{{ forloop.index0 }}" data-option="{{ forloop.index0 }}">
                {%- for value in option.values -%}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>{%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- endunless -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
        <input type="hidden" name="quantity" value="1">
        {%- if section.settings.bundle_show -%}
          {%- liquid
            assign addons = ''
            assign n = 0
            assign kinds = 'Pouch,Card' | split: ','
            for kind in kinds
              if n >= section.settings.bundle_max
                break
              endif
              assign pick = blank
              for p in collections.all.products
                if p.id == product.id or p.available == false or p.price >= product.price or p.title contains 'Set'
                  continue
                endif
                unless p.title contains kind
                  continue
                endunless
                if pick == blank
                  assign pick = p
                endif
                if colour != blank and p.title contains colour
                  assign pick = p
                  break
                endif
              endfor
              if pick != blank
                assign n = n | plus: 1
                assign addons = addons | append: pick.handle | append: ','
              endif
            endfor
            assign pct2 = section.settings.bundle_pct_2
            assign pct3 = section.settings.bundle_pct_3
          -%}
          {%- if n > 0 -%}
            <div class="bundle" data-bundle data-main-price="{{ current.price }}" data-pct2="{{ pct2 }}" data-pct3="{{ pct3 }}">
              <div class="bundle__head">
                <p class="bundle__title">{{ section.settings.bundle_heading }}</p>
                <p class="bundle__tiers"><span>2 pieces <b>-{{ pct2 }}%</b></span><span>3+ pieces <b>-{{ pct3 }}%</b></span></p>
              </div>
              {%- assign hs = addons | split: ',' -%}
              {%- for h in hs -%}
                {%- assign p = collections.all.products | where: 'handle', h | first -%}
                {%- if p == blank -%}{%- continue -%}{%- endif -%}
                <label class="bundle__item">
                  <span class="bundle__img">{{ p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: p.title }}</span>
                  <span class="bundle__info"><strong>{{ p.title }}</strong><span class="bundle__price"><s>{{ p.price | money }}</s> <span data-bundle-from="{{ p.price }}">{%- assign keep = 100 | minus: pct2 -%}{{ p.price | times: keep | divided_by: 100 | money }}</span></span></span>
                  <input type="checkbox" class="bundle__check" value="{{ p.selected_or_first_available_variant.id }}" data-bundle-item data-price="{{ p.price }}" aria-label="Add {{ p.title | escape }}">
                </label>
              {%- endfor -%}
              <p class="bundle__sum" data-bundle-sum hidden>Set total <b data-bundle-total></b> <s data-bundle-was></s> <span class="bundle__save">You save <b data-bundle-save></b></span></p>
            </div>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.gift_wrap -%}
          <label class="pdp-gift">
            <span class="pdp-gift__icon">{% render 'icon', name: 'gift' %}</span>
            <span class="pdp-gift__text"><strong>{{ section.settings.gift_title }}</strong><small>{{ section.settings.gift_text }}</small></span>
            <span class="pdp-gift__price">{{ section.settings.gift_price }}</span>
            <input type="checkbox" name="properties[Gift wrapping]" value="Yes" class="switch">
          </label>
        {%- endif -%}
        <button type="submit" class="btn btn--dark btn--block btn--lg btn--atc" data-atc{% unless current.available %} disabled{% endunless %}>
          {%- render 'icon', name: 'bag' -%}
          <span data-atc-label>{%- if current.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</span>
          <span class="btn--atc__price" data-atc-price{% unless current.available %} hidden{% endunless %}>{{ current.price | money }}</span>
        </button>
        {%- if section.settings.dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
      {%- endform -%}
      <p class="pdp-trust"><span>{% render 'icon', name: 'return' %} 14-day returns</span><span>{% render 'icon', name: 'truck' %} Free shipping</span><span>{% render 'icon', name: 'seal' %} Genuine leather</span></p>


      {%- assign vids = section.blocks | where: 'type', 'video' -%}
      {%- if vids.size > 0 -%}
        <div class="pdp-videos">
          <p class="pdp-videos__head">{{ section.settings.videos_heading }}</p>
          <div class="pdp-videos__grid">
            {%- for block in vids -%}
              <figure class="pdp-video" {{ block.shopify_attributes }}>
                <div class="pdp-video__media" data-play>
                  {% render 'video', video: block.settings.video, video_asset: block.settings.video_asset, poster: block.settings.poster, class: 'cover', manual: true %}
                  <button type="button" class="pdp-video__btn" aria-label="Play {{ block.settings.caption | escape }}">{% render 'icon', name: 'play' %}</button>
                </div>
                <figcaption>{{ block.settings.caption }}</figcaption>
              </figure>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if product.description != blank -%}<div class="pdp-desc rte">{{ product.description }}</div>{%- endif -%}

      {%- assign qs = section.blocks | where: 'type', 'question' -%}
      {%- if qs.size > 0 -%}
        <div class="pdp-ask" data-ask>
          <div class="pdp-ask__chips">
            {%- for block in qs -%}
              <button type="button" class="pdp-ask__chip" data-ask-q="{{ forloop.index }}" aria-expanded="false" {{ block.shopify_attributes }}>{% render 'icon', name: 'sparkle' %} {{ block.settings.question }}</button>
            {%- endfor -%}
          </div>
          {%- for block in qs -%}
            <div class="pdp-ask__answer" data-ask-a="{{ forloop.index }}" hidden>
              <p class="pdp-ask__q">{{ block.settings.question }}</p>
              <div class="pdp-ask__bubble"><span class="pdp-ask__from">Rano</span>{{ block.settings.answer }}</div>
            </div>
          {%- endfor -%}
          <form action="{{ section.settings.ask_link }}" method="get" class="pdp-ask__form">
            <input type="hidden" name="product" value="{{ product.title | escape }}">
            <label class="visually-hidden" for="ask-{{ section.id }}">Ask us anything</label>
            <input id="ask-{{ section.id }}" name="q" type="text" placeholder="Ask us anything..." autocomplete="off" required>
            <button type="submit" aria-label="Send question">{% render 'icon', name: 'arrow-up' %}</button>
          </form>
        </div>
      {%- endif -%}

      <div class="accordion accordion--icons">
        {%- for block in section.blocks -%}
          {%- if block.type != 'accordion' -%}{%- continue -%}{%- endif -%}
          <details {{ block.shopify_attributes }}>
            <summary><span>{%- if block.settings.icon != blank -%}{% render 'icon', name: block.settings.icon %}{%- endif -%}{{ block.settings.title }}</span> {% render 'icon', name: 'caret-down' %}</summary>
            <div class="rte">{{ block.settings.content }}</div>
          </details>
        {%- endfor -%}
      </div>

      {%- if section.settings.also_love_heading != blank -%}
        {%- liquid
          assign pool = collections.all.products
          assign shown = 0
        -%}
        <div class="pdp-love">
          <p class="pdp-love__head">{{ section.settings.also_love_heading }}</p>
          <div class="pdp-love__grid">
            {%- for p in pool -%}
              {%- if p.id == product.id or shown >= 4 -%}{%- continue -%}{%- endif -%}
              {%- assign shown = shown | plus: 1 -%}
              <a href="{{ p.url }}" class="pdp-love__item">
                <span class="pdp-love__img">{{ p.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '160px', alt: p.title }}</span>
                <span class="pdp-love__title">{{ p.title }}</span>
                <span class="pdp-love__price">{% render 'price', price: p.price, compare: p.compare_at_price %}</span>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="sticky-atc" data-sticky-atc hidden>
    <div class="sticky-atc__info">
      <span class="sticky-atc__title">{{ product.title }}</span>
      {% render 'price', price: current.price, compare: current.compare_at_price %}
    </div>
    <button type="button" class="btn btn--dark" data-sticky-submit{% unless current.available %} disabled{% endunless %}>{{ 'products.add_to_cart' | t }}</button>
  </div>

  <script type="application/json" data-variants>{{ product.variants | json }}</script>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "image": [{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}{% endif %}],
  "description": {{ product.description | strip_html | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "offers": {
    "@type": "Offer",
    "url": {{ request.origin | append: product.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ current.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{% if current.available %}InStock{% else %}OutOfStock{% endif %}"
  }
}
</script>

{% schema %}
{
  "name": "Product",
  "class": "section-pdp",
  "settings": [
    { "type": "checkbox", "id": "dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true },
    { "type": "checkbox", "id": "spin", "label": "Drag-to-rotate on first image", "info": "Turns through the product photos with a 3D effect. Real 3D models (.glb media) are shown automatically when uploaded.", "default": true },
    { "type": "url", "id": "shipping_link", "label": "Shipping policy link", "default": "/policies/shipping-policy" },
    { "type": "text", "id": "videos_heading", "label": "Video blocks heading", "default": "See it in motion" },
    { "type": "header", "content": "Complete the set (bundle)" },
    { "type": "checkbox", "id": "bundle_show", "label": "Show smaller add-on products", "default": true, "info": "Lists cheaper products (no sets) as add-ons. The discount itself must be an automatic discount in Shopify, see README." },
    { "type": "text", "id": "bundle_heading", "label": "Heading", "default": "Complete the set & save" },
    { "type": "range", "id": "bundle_max", "label": "Max add-ons", "info": "One per type: a pouch and a card holder, matching colour first.", "min": 1, "max": 2, "step": 1, "default": 2 },
    { "type": "range", "id": "bundle_pct_2", "label": "Discount with 2 pieces (%)", "min": 0, "max": 40, "step": 1, "default": 10 },
    { "type": "range", "id": "bundle_pct_3", "label": "Discount with 3+ pieces (%)", "min": 0, "max": 40, "step": 1, "default": 15 },
    { "type": "header", "content": "Gift wrapping" },
    { "type": "checkbox", "id": "gift_wrap", "label": "Show gift wrapping option", "info": "Adds the line item property 'Gift wrapping: Yes' to the order.", "default": false },
    { "type": "text", "id": "gift_title", "label": "Title", "default": "Add gift wrapping" },
    { "type": "text", "id": "gift_text", "label": "Text", "default": "Wrapped in tissue in a Rano gift box, with a handwritten card." },
    { "type": "text", "id": "gift_price", "label": "Price label", "default": "Free" },
    { "type": "header", "content": "Questions" },
    { "type": "url", "id": "ask_link", "label": "'Ask us anything' sends to", "default": "/pages/contact-form" },
    { "type": "text", "id": "also_love_heading", "label": "'You'll also love' heading", "default": "You'll also love" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Details & care" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "info", "options": [
          { "value": "info", "label": "Details" }, { "value": "drop", "label": "Care" }, { "value": "truck", "label": "Shipping" }, { "value": "return", "label": "Returns" }, { "value": "seal", "label": "Quality" }
        ]},
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>100% genuine leather with silver-tone hardware. Wipe with a soft dry cloth. Keep away from prolonged direct sunlight.</p>" }
      ]
    },
    {
      "type": "question",
      "name": "Quick question",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Does it fit as cabin luggage?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. The Traveller fits most airline cabin rules.</p>" }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "limit": 3,
      "settings": [
        { "type": "video", "id": "video", "label": "Video (upload)", "info": "Vertical 9:16, e.g. an Instagram reel." },
        { "type": "text", "id": "video_asset", "label": "Bundled video file" },
        { "type": "text", "id": "poster", "label": "Bundled poster image" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Made for weekends" }
      ]
    }
  ]
}
{% endschema %}
