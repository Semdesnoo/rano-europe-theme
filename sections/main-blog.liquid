{%- paginate blog.articles by 12 -%}
<section class="section">
  <div class="container">
    <header class="page-head"><h1 class="h1">{{ blog.title }}</h1></header>
    <div class="tiles">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="post reveal">
          <div class="post__media">{%- if article.image -%}{{ article.image | image_url: width: 1000 | image_tag: widths: '400, 700, 1000', sizes: '(min-width: 990px) 33vw, 100vw', class: 'cover', loading: 'lazy', alt: article.title }}{%- endif -%}</div>
          <p class="muted small">{{ article.published_at | date: '%d %B %Y' }}</p>
          <h2 class="h3">{{ article.title }}</h2>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "class": "section-blog", "settings": [] }
{% endschema %}
