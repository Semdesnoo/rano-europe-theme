<section class="section">
  <div class="container narrow">
    <header class="page-head"><h1 class="h1">{{ 'cart.title' | t }}</h1></header>
    {%- if cart.item_count == 0 -%}
      <p class="muted">{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--dark">Shop the collection</a>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-page">
        <ul class="cart-lines">
          {%- for item in cart.items -%}
            <li class="cart-line">
              <a href="{{ item.url }}" class="cart-line__img">{%- if item.image -%}{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title }}{%- endif -%}</a>
              <div class="cart-line__info">
                <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="muted">{{ item.variant.title }}</p>{%- endunless -%}
                {% render 'price', price: item.final_line_price, compare: item.original_line_price %}
                <label class="visually-hidden" for="q-{{ forloop.index }}">{{ 'products.quantity' | t }}</label>
                <input class="qty-input" id="q-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
              </div>
              <a href="{{ item.url_to_remove }}" class="cart-line__remove link">{{ 'cart.remove' | t }}</a>
            </li>
          {%- endfor -%}
        </ul>
        <div class="cart-page__foot">
          <div class="cart-total"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></div>
          <p class="muted small">{{ 'cart.taxes' | t }}</p>
          <div class="cart-page__actions">
            <button type="submit" name="update" class="btn btn--outline">Update</button>
            <button type="submit" name="checkout" class="btn btn--dark">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "class": "section-cart", "settings": [] }
{% endschema %}
