<section class="section product-tabs" data-tabs>
  <div class="container">
    <div class="section-head">
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="tabs" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" role="tab" class="tab{% if forloop.first %} is-active{% endif %}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="panel-{{ block.id }}" data-tab="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ block.settings.title }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  {%- for block in section.blocks -%}
    {%- assign coll = block.settings.collection | default: collections.all -%}
    <div class="tab-panel" id="panel-{{ block.id }}" role="tabpanel" data-panel{% unless forloop.first %} hidden{% endunless %}>
      <div class="carousel" data-carousel>
        {%- for product in coll.products limit: section.settings.limit -%}
          <div class="carousel__item">{% render 'product-card', product: product %}</div>
        {%- else -%}
          <p class="container muted">Add products to this collection to show them here.</p>
        {%- endfor -%}
      </div>
    </div>
  {%- endfor -%}
  {%- if section.settings.link_label != blank -%}
    <div class="container"><a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="link-arrow">{{ section.settings.link_label }} {% render 'icon', name: 'arrow-right' %}</a></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product tabs",
  "class": "section-tabs",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "All" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [{ "name": "Product tabs", "blocks": [{ "type": "tab" }] }]
}
{% endschema %}
