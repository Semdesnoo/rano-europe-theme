<section class="hero hero--{{ section.settings.height }}" data-slideshow data-interval="{{ section.settings.interval }}" aria-roledescription="carousel" aria-label="Featured">
  {%- for block in section.blocks -%}
    {%- liquid
      assign s = block.settings
      assign has_video = false
      if s.video or s.video_asset != blank
        assign has_video = true
      endif
    -%}
    <div class="hero__slide{% if forloop.first %} is-active{% endif %}" data-slide aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}" {{ block.shopify_attributes }}>
      <div class="hero__media hero__media--{{ s.layout }}">
        {%- if has_video -%}
          {% render 'video', video: s.video, video_asset: s.video_asset, poster: s.fallback, class: 'cover' %}
        {%- elsif s.layout == 'trio' -%}
          {% render 'media', image: s.image, fallback: s.fallback, sizes: '(min-width: 750px) 34vw, 100vw', class: 'cover', eager: forloop.first, alt: s.heading %}
          {% render 'media', image: s.image_2, fallback: s.fallback_2, sizes: '34vw', class: 'cover hide-mobile', alt: s.heading %}
          {% render 'media', image: s.image_3, fallback: s.fallback_3, sizes: '34vw', class: 'cover hide-mobile', alt: s.heading %}
        {%- else -%}
          {% render 'media', image: s.image, fallback: s.fallback, sizes: '100vw', class: 'cover', eager: forloop.first, alt: s.heading %}
        {%- endif -%}
      </div>
      <div class="hero__content container">
        {%- if forloop.first -%}<h1 class="hero__title">{{ s.heading }}</h1>{%- else -%}<h2 class="hero__title">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<p class="hero__text">{{ s.text }}</p>{%- endif -%}
        {%- if s.button_label != blank -%}<a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="btn btn--light">{{ s.button_label }}</a>{%- endif -%}
      </div>
    </div>
  {%- endfor -%}
  {%- if section.blocks.size > 1 -%}
    <div class="hero__dots" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" data-dot="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"><span></span></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero slideshow",
  "class": "section-hero",
  "max_blocks": 5,
  "settings": [
    { "type": "select", "id": "height", "label": "Height", "default": "large", "options": [
      { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }, { "value": "full", "label": "Full screen" }
    ]},
    { "type": "range", "id": "interval", "label": "Autoplay (seconds, 0 = off)", "min": 0, "max": 12, "step": 1, "default": 7 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "select", "id": "layout", "label": "Layout", "default": "single", "options": [
          { "value": "single", "label": "Single image or video" }, { "value": "trio", "label": "Three images side by side" }
        ]},
        { "type": "video", "id": "video", "label": "Video (upload)", "info": "Plays muted on loop. Upload an Instagram reel here." },
        { "type": "text", "id": "video_asset", "label": "Bundled video file", "info": "Theme asset used when no video is uploaded." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Bundled image file", "info": "Theme asset used when no image is selected. Also used as video poster." },
        { "type": "image_picker", "id": "image_2", "label": "Image 2 (trio)" },
        { "type": "text", "id": "fallback_2", "label": "Bundled image 2" },
        { "type": "image_picker", "id": "image_3", "label": "Image 3 (trio)" },
        { "type": "text", "id": "fallback_3", "label": "Bundled image 3" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Designed in Italy. Carried everywhere." },
        { "type": "text", "id": "text", "label": "Text", "default": "Genuine leather travel pieces, made in small numbers." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [{ "name": "Hero slideshow", "blocks": [{ "type": "slide" }] }]
}
{% endschema %}
