{%- liquid
  assign s = section.settings
  assign show = true
  if s.home_only and template.name != 'index'
    assign show = false
  endif
-%}
{%- if show -%}
<div class="promo" data-countdown="{{ s.end }}" data-expired-hide>
  <div class="promo__timer" aria-live="off">
    <span class="promo__unit"><b data-d>00</b> Days</span>
    <span class="promo__unit"><b data-h>00</b> Hrs</span>
    <span class="promo__unit"><b data-m>00</b> Min</span>
    <span class="promo__unit"><b data-s>00</b> Sec</span>
    <span class="promo__label">{{ s.timer_label }}</span>
  </div>
  <div class="promo__bar">
    <p class="promo__text"><strong>{{ s.heading }}</strong> {%- if s.text != blank %} <span>{{ s.text }}</span>{% endif %}</p>
    {%- if s.code != blank -%}
      <button type="button" class="promo__code" data-copy="{{ s.code | escape }}" aria-label="Copy code {{ s.code | escape }}">
        <span>{{ s.code }}</span>
        <span class="promo__copy">{% render 'icon', name: 'copy' %}<span data-copy-label>Copy</span></span>
      </button>
    {%- elsif s.link != blank -%}
      <a href="{{ s.link }}" class="promo__code"><span>{{ s.link_label }}</span></a>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Countdown promo",
  "class": "section-promo",
  "settings": [
    { "type": "text", "id": "end", "label": "Ends at", "info": "Date and time, e.g. 2026-11-30T23:59:00+01:00. The bar hides itself after this moment.", "default": "2026-11-30T23:59:00+01:00" },
    { "type": "checkbox", "id": "home_only", "label": "Only on the homepage", "default": true },
    { "type": "text", "id": "timer_label", "label": "Timer label", "default": "Black Friday ends in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Black Friday: up to 35% off" },
    { "type": "text", "id": "text", "label": "Text", "default": "Use code at checkout" },
    { "type": "text", "id": "code", "label": "Discount code", "info": "Leave empty when the discount applies automatically." },
    { "type": "url", "id": "link", "label": "Button link (when no code)" },
    { "type": "text", "id": "link_label", "label": "Button label (when no code)", "default": "Shop the sale" }
  ],
  "presets": [{ "name": "Countdown promo" }]
}
{% endschema %}
