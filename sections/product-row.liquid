{%- assign coll = section.settings.collection | default: collections.all -%}
<section class="section product-row">
  <div class="container section-head">
    <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link | default: coll.url }}" class="link-arrow">{{ section.settings.link_label }} {% render 'icon', name: 'arrow-right' %}</a>
    {%- endif -%}
  </div>
  <div class="carousel" data-carousel>
    {%- for p in coll.products limit: 13 -%}
      {%- if product and p.id == product.id -%}{%- continue -%}{%- endif -%}
      <div class="carousel__item">{% render 'product-card', product: p %}</div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Product row",
  "class": "section-row",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the set" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to all products." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Product row" }]
}
{% endschema %}
