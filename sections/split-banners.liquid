<section class="section">
  <div class="container split">
    {%- for block in section.blocks -%}
      {%- assign s = block.settings -%}
      <a href="{{ s.link | default: routes.all_products_collection_url }}" class="split__item reveal" {{ block.shopify_attributes }}>
        {% render 'media', image: s.image, fallback: s.fallback, sizes: '(min-width: 750px) 50vw, 100vw', class: 'cover', alt: s.heading %}
        <div class="split__content">
          <h2 class="split__title">{{ s.heading }}</h2>
          {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
          {%- if s.button_label != blank -%}<span class="btn btn--light">{{ s.button_label }}</span>{%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Split banners",
  "class": "section-split",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Bundled image file" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "The Traveller" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Split banners", "blocks": [{ "type": "banner" }, { "type": "banner" }] }]
}
{% endschema %}
