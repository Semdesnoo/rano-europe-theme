<section class="password">
  <div class="password__media">{% render 'media', image: section.settings.image, fallback: 'model-giallo.jpg', class: 'cover', eager: true, alt: shop.name %}</div>
  <div class="password__panel">
    <img src="{{ 'logo-black.png' | asset_url }}" class="logo" alt="{{ shop.name }}" width="948" height="355">
    <h1 class="h1">{{ section.settings.heading }}</h1>
    <p class="muted">{{ section.settings.text }}</p>
    {%- form 'customer', class: 'news-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-ok" role="status">You are on the list.</p>
      {%- else -%}
        <label for="pw-email" class="news-form__label">Email</label>
        <div class="news-form__row">
          <input id="pw-email" type="email" name="contact[email]" required autocomplete="email" placeholder="you@example.com">
          <button type="submit" class="icon-btn" aria-label="Notify me">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary class="small">Store owner? Enter password</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="form-err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label for="pw" class="news-form__label">Password</label>
        <div class="news-form__row">
          <input id="pw" type="password" name="password" autocomplete="current-password">
          <button type="submit" class="icon-btn" aria-label="Enter">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "class": "section-password",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something new is coming" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Limited release. No restocks. Sign up for early access." }
  ]
}
{% endschema %}
