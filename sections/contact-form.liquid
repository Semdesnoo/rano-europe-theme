<section class="section contact">
  <div class="container contact__grid">
    <div>
      <h1 class="h1">{{ section.settings.heading }}</h1>
      <div class="rte">{{ section.settings.text }}</div>
    </div>
    {%- form 'contact', class: 'form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-ok" role="status">Thank you for your message. We will reply within one working day.</p>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="form-err" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field">
        <label for="c-name">Name</label>
        <input id="c-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="field">
        <label for="c-email">Email <span aria-hidden="true">*</span></label>
        <input id="c-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
      </div>
      <div class="field">
        <label for="c-order">Order number</label>
        <input id="c-order" type="text" name="contact[order]">
      </div>
      <div class="field">
        <label for="c-body">Message <span aria-hidden="true">*</span></label>
        <textarea id="c-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
      </div>
      <button type="submit" class="btn btn--dark">Send message</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about an order, a product or a collaboration? Send us a message.</p>" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
