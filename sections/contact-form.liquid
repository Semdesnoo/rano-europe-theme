{%- assign actions = section.blocks | where: 'type', 'action' -%}
<section class="section cform-page">
  <div class="container cform-wrap">
    <nav class="cform-crumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" aria-label="Home">{% render 'icon', name: 'home' %}</a>
      {% render 'icon', name: 'caret-right' %}
      {%- if section.settings.help_page != blank -%}<a href="{{ section.settings.help_page }}">Help centre</a>{% render 'icon', name: 'caret-right' %}{%- endif -%}
      <span>{{ section.settings.heading }}</span>
    </nav>

    {%- if actions.size > 0 -%}
      <div class="help-actions help-actions--sm">
        {%- for block in actions -%}
          <a href="{{ block.settings.link | default: '#cform' }}" class="help-action" data-subject="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>
            <span class="help-action__icon">{% render 'icon', name: 'package' %}<span class="help-action__badge">{% render 'icon', name: block.settings.icon %}</span></span>
            <span class="help-action__label">{{ block.settings.label }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="cform" id="cform">
      <h1 class="cform__title">{{ section.settings.heading }}</h1>
      {%- form 'contact', class: 'cform__body' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-ok" role="status">{{ section.settings.success }}</p>
        {%- else -%}
          {%- if form.errors -%}<div class="form-err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="cfield">
            <label for="cf-name">Full name <span class="req">*</span></label>
            <small id="cf-name-h">Enter your first and last name</small>
            <input id="cf-name" type="text" name="contact[name]" autocomplete="name" required aria-describedby="cf-name-h" value="{{ form.name }}">
          </div>
          <div class="cfield">
            <label for="cf-email">Email <span class="req">*</span></label>
            <small id="cf-email-h">you@email.com</small>
            <input id="cf-email" type="email" name="contact[email]" autocomplete="email" required aria-describedby="cf-email-h" value="{{ form.email }}">
          </div>
          <div class="cfield">
            <label for="cf-subject">Subject <span class="req">*</span></label>
            <small id="cf-subject-h">Type a subject</small>
            <input id="cf-subject" type="text" name="contact[subject]" required aria-describedby="cf-subject-h" data-cform-subject>
          </div>
          <div class="cfield">
            <label for="cf-order">Order number</label>
            <small id="cf-order-h">Optional, e.g. #1001</small>
            <input id="cf-order" type="text" name="contact[order]" aria-describedby="cf-order-h">
          </div>
          <div class="cfield">
            <label for="cf-body">Message <span class="req">*</span></label>
            <textarea id="cf-body" name="contact[body]" rows="5" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="btn btn--dark btn--block">Send</button>
          {%- if shop.privacy_policy -%}<p class="cform__note">By sending this form you agree to our <a href="{{ shop.privacy_policy.url }}" class="link">Privacy Policy</a>.</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "url", "id": "help_page", "label": "Help centre page (breadcrumb)", "default": "/pages/contact" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thank you for your message. We will reply within one working day." }
  ],
  "blocks": [
    { "type": "action", "name": "Quick action", "limit": 4, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Track order" },
      { "type": "select", "id": "icon", "label": "Badge", "default": "search", "options": [
        { "value": "search", "label": "Track" }, { "value": "return", "label": "Return" }, { "value": "cancel", "label": "Cancel" }, { "value": "warning", "label": "Problem" }
      ]},
      { "type": "url", "id": "link", "label": "Link", "info": "Empty = fills in the subject of the form." }
    ]}
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
