{%- assign s = section.settings -%}
<section class="apply">
  <div class="apply__hero">
    {% render 'media', image: s.image, fallback: s.fallback, sizes: '100vw', class: 'cover', alt: '', loading: 'eager' %}
    <div class="apply__hero-text">
      {%- if s.eyebrow != blank -%}<p class="apply__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h1 class="apply__title">{{ s.heading }}</h1>
    </div>
  </div>

  <div class="container apply__wrap">
    <div class="apply__intro">
      <h2 class="apply__h2">{{ s.intro_heading }}</h2>
      <div class="rte">{{ s.intro }}</div>
    </div>

    {%- form 'contact', class: 'apply__form', id: section.id -%}
      {%- if form.posted_successfully? -%}
        <div class="form-ok apply__ok" role="status">{% render 'icon', name: 'verified' %}<div><strong>Grazie!</strong><p>{{ s.success }}</p></div></div>
      {%- else -%}
        {%- if form.errors -%}<div class="form-err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <input type="hidden" name="contact[Form]" value="{{ s.form_name | escape }}">
        <div class="apply__grid">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- assign fid = 'f-' | append: block.id -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                <h3 class="apply__group" {{ block.shopify_attributes }}>{{ b.title }}</h3>
              {%- when 'field' -%}
                <div class="cfield{% if b.half %} cfield--half{% endif %}" {{ block.shopify_attributes }}>
                  <label for="{{ fid }}">{{ b.label }}{% if b.required %} <span class="req">*</span>{% endif %}</label>
                  {%- liquid
                    assign fname = 'contact[' | append: b.label | append: ']'
                    if b.kind == 'email'
                      assign fname = 'contact[email]'
                    elsif b.kind == 'name'
                      assign fname = 'contact[name]'
                    endif
                    assign ftype = b.kind
                    if ftype == 'name'
                      assign ftype = 'text'
                    endif
                  -%}
                  <input id="{{ fid }}" type="{{ ftype }}" name="{{ fname }}"{% if b.placeholder != blank %} placeholder="{{ b.placeholder | escape }}"{% endif %}{% if b.required %} required{% endif %}{% if b.kind == 'email' %} autocomplete="email"{% elsif b.kind == 'name' %} autocomplete="name"{% elsif b.kind == 'tel' %} autocomplete="tel"{% endif %}>
                </div>
              {%- when 'choices' -%}
                <fieldset class="apply__choices" {{ block.shopify_attributes }}>
                  <legend>{{ b.label }}{% if b.required %} <span class="req">*</span>{% endif %}</legend>
                  <div class="apply__chips"{% if b.required and b.multiple %} data-need-one{% endif %}>
                    {%- assign opts = b.options | split: ',' -%}
                    {%- for o in opts -%}
                      {%- assign o = o | strip -%}
                      <label class="apply__chip">
                        {%- if b.multiple -%}
                          <input type="checkbox" name="contact[{{ b.label }}: {{ o }}]" value="Yes">
                        {%- else -%}
                          <input type="radio" name="contact[{{ b.label }}]" value="{{ o | escape }}"{% if b.required %} required{% endif %}>
                        {%- endif -%}
                        <span>{{ o }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- when 'message' -%}
                <div class="cfield" {{ block.shopify_attributes }}>
                  <label for="{{ fid }}">{{ b.label }}{% if b.required %} <span class="req">*</span>{% endif %}</label>
                  <textarea id="{{ fid }}" name="contact[body]" rows="5"{% if b.placeholder != blank %} placeholder="{{ b.placeholder | escape }}"{% endif %}{% if b.required %} required{% endif %}></textarea>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
        <button type="submit" class="btn btn--dark btn--block btn--lg">{{ s.button }}</button>
        <p class="cform__note">We reply within 2 working days. By sending this form you agree to our <a href="/policies/privacy-policy" class="link">Privacy Policy</a>.</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Application form",
  "class": "section-apply",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "fallback", "label": "Bundled hero image file" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "La famiglia Rano" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Partner with Rano" },
    { "type": "text", "id": "intro_heading", "label": "Intro heading", "default": "Interested in working with us?" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Fill in your details below and we'll be in touch soon.</p>" },
    { "type": "text", "id": "form_name", "label": "Form name (shown in the email you receive)", "default": "Partnership" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Send application" },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "We received your application and will get back to you within 2 working days." }
  ],
  "blocks": [
    { "type": "heading", "name": "Group heading", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "About you" } ] },
    { "type": "field", "name": "Field", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Country" },
      { "type": "select", "id": "kind", "label": "Type", "default": "text", "options": [
        { "value": "name", "label": "Name" }, { "value": "email", "label": "Email" }, { "value": "text", "label": "Text" }, { "value": "tel", "label": "Phone" }, { "value": "url", "label": "Link" }, { "value": "number", "label": "Number" }, { "value": "date", "label": "Date" }
      ]},
      { "type": "text", "id": "placeholder", "label": "Placeholder" },
      { "type": "checkbox", "id": "required", "label": "Required", "default": false },
      { "type": "checkbox", "id": "half", "label": "Half width", "default": true }
    ]},
    { "type": "choices", "name": "Choices", "settings": [
      { "type": "text", "id": "label", "label": "Question", "default": "How would you like to collaborate?" },
      { "type": "text", "id": "options", "label": "Options (comma separated)", "default": "Gifting, UGC, PR, Ambassador, Other" },
      { "type": "checkbox", "id": "multiple", "label": "Allow multiple", "default": true },
      { "type": "checkbox", "id": "required", "label": "Required", "default": false }
    ]},
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Tell us more" },
      { "type": "text", "id": "placeholder", "label": "Placeholder" },
      { "type": "checkbox", "id": "required", "label": "Required", "default": false }
    ]}
  ],
  "presets": [{ "name": "Application form" }]
}
{% endschema %}
