<article class="section">
  <div class="container narrow">
    <header class="page-head">
      <p class="muted small">{{ article.published_at | date: '%d %B %Y' }}</p>
      <h1 class="h1">{{ article.title }}</h1>
    </header>
    {%- if article.image -%}<div class="article__media">{{ article.image | image_url: width: 1600 | image_tag: widths: '600, 1000, 1600', sizes: '(min-width: 990px) 800px, 100vw', class: 'cover', alt: article.title }}</div>{%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <a href="{{ blog.url }}" class="link-arrow">Back to {{ blog.title }} {% render 'icon', name: 'arrow-right' %}</a>
  </div>
</article>

{% schema %}
{ "name": "Article", "class": "section-article", "settings": [] }
{% endschema %}
